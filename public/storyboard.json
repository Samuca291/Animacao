      "cast": [ { "id": "ana", "x": 760, "pose": "idle", "expression": "neutral" } ],
      "props": [ { "id": "airfryer", "x": 1380, "y": 640 }, { "id": "mug", "x": 1080, "y": 640, "steam": true } ],
