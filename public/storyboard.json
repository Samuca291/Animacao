    {
      "id": "s03-conta",
      "type": "edit",
      "act": "A conta",
      "narration": "Vamos à conta. Dia um: duas vezes a inteligência original. Dia dois: quatro. Dia três: oito. Parece pouco. Mas no dia sete já são cento e vinte e oito vezes. No dia dez, mil e vinte e quatro. No dia vinte, mais de um milhão. E no dia trinta, mais de um bilhão.",
      "background": "grid",
      "layers": [
        { "id": "formula", "kind": "equation", "at_word": "conta", "slot": "top", "enter": "drop", "props": { "text": "inteligência = 2", "exp": "dia" } },
        { "id": "escada", "kind": "ladder", "at_word": "um", "slot": "left", "items": [
          { "at_word": "um", "day": 1 }, { "at_word": "dois", "day": 2 }, { "at_word": "três", "day": 3 },
          { "at_word": "sete", "day": 7 }, { "at_word": "dez", "day": 10 }, { "at_word": "vinte", "nth": 3, "day": 20 }, { "at_word": "trinta", "day": 30 }
        ] },
        { "id": "contador", "kind": "counter", "at_word": "um", "slot": "right", "props": { "size": 150 }, "items": [
          { "at_word": "um", "day": 1 }, { "at_word": "dois", "day": 2 }, { "at_word": "três", "day": 3 },
          { "at_word": "sete", "day": 7 }, { "at_word": "dez", "day": 10 }, { "at_word": "vinte", "nth": 3, "day": 20 }, { "at_word": "trinta", "day": 30 }
        ] },
        { "id": "blocos", "kind": "blocks", "at_word": "um", "until_word": "sete", "slot": "right-down", "items": [ { "at_word": "um", "day": 1 }, { "at_word": "dois", "day": 2 }, { "at_word": "três", "day": 3 } ] },
        { "id": "pouco", "kind": "kinetic", "at_word": "parece", "until_word": "sete", "slot": "right-up", "enter": "slide-up", "props": { "text": "parece pouco…", "size": 64, "color": "#9aa7c7" } }
      ],
